# .env.example
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (existing) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only signing key for the dashboard's 30-minute idle timeout.
# When unset, a domain-separated HMAC uses SUPABASE_SERVICE_ROLE_KEY.
# Never use a NEXT_PUBLIC_ variable. Rotation requires fresh dashboard logins.
DASHBOARD_SESSION_SECRET=

# Dev-only escape hatch — see src/lib/supabaseClient.ts. Leave unset in any
# real environment.
FORCE_MOCK_DATA=

# --- Assessment pairing/upload system ---

# Server-only HMAC key for hashing pairing codes (see src/lib/assessmentCrypto.ts).
# A 6-digit pairing code has only 10^6 possible values, so a PLAIN hash is not
# sufficient if the pairing_codes table is ever exposed — this key is what
# makes the stored hash useless without it. Generate with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER put this value in Unity, Supabase client code, a migration file, or
# source control — server environment variables only.
PAIRING_CODE_HMAC_SECRET=

# Server-only HMAC key for hashing caller IP addresses before they're used as
# a rate-limit bucket key (see src/lib/rateLimit.ts) — raw IPs are never
# stored. Generate the same way as PAIRING_CODE_HMAC_SECRET, with a DIFFERENT
# value (key separation between the two purposes).
RATE_LIMIT_IP_HASH_SECRET=

# --- VR student access codes (supabase/migrations/018) ---

# Shared device key the headset sends as `Authorization: Bearer <key>` to
# GET /api/v1/vr/student-directory and POST /api/v1/vr/validate-code (see
# src/lib/vrAccessCodes.ts checkVrDeviceKey). Unset = both routes refuse every
# request. Generate the same way as the secrets above, with its own value.
# Unlike the two secrets above this one IS installed on headsets, so treat it as
# "classroom device" trust, not a server secret: rotate it if a headset is lost.
VR_DEVICE_SYNC_KEY=

# Student number of the EXISTING test student that the headset's "Continue Without
# Code" assigns sessions to (the John Doe record from
# supabase/seed/seed-john-doe-bypass-identity.mjs). Defaults to 2099-00099 when
# unset; "none" disables test mode. Never creates a student.
# VR_TEST_STUDENT_NUMBER=2099-00099

# Optional — override any of these to retune rate limits without a code
# change. All limits are "N requests per WINDOW_SECONDS", enforced via the
# shared check_rate_limit() Postgres function (supabase/migrations/012_rate_limiting.sql).
# Defaults shown; uncomment and change only what you need.
# RATE_LIMIT_PAIRING_CREATE_MAX=5
# RATE_LIMIT_PAIRING_CREATE_WINDOW_SECONDS=60
# RATE_LIMIT_PAIRING_EXCHANGE_MAX=10
# RATE_LIMIT_PAIRING_EXCHANGE_WINDOW_SECONDS=60
# RATE_LIMIT_PAIRING_EXCHANGE_IP_MAX=30
# RATE_LIMIT_PAIRING_EXCHANGE_IP_WINDOW_SECONDS=60
# RATE_LIMIT_SUBMISSION_TOKEN_MAX=20
# RATE_LIMIT_SUBMISSION_TOKEN_WINDOW_SECONDS=60
# RATE_LIMIT_SUBMISSION_SESSION_MAX=10
# RATE_LIMIT_SUBMISSION_SESSION_WINDOW_SECONDS=60
# RATE_LIMIT_VR_VALIDATE_MAX=10
# RATE_LIMIT_VR_VALIDATE_WINDOW_SECONDS=60
# RATE_LIMIT_VR_VALIDATE_IP_MAX=30
# RATE_LIMIT_VR_VALIDATE_IP_WINDOW_SECONDS=60
# RATE_LIMIT_VR_DIRECTORY_IP_MAX=20
# RATE_LIMIT_VR_DIRECTORY_IP_WINDOW_SECONDS=60
# RATE_LIMIT_VR_UPLOAD_TOKEN_IP_MAX=60
# RATE_LIMIT_VR_UPLOAD_TOKEN_IP_WINDOW_SECONDS=60
# RATE_LIMIT_VR_UPLOAD_TOKEN_SESSION_MAX=10
# RATE_LIMIT_VR_UPLOAD_TOKEN_SESSION_WINDOW_SECONDS=60
