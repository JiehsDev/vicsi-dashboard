{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test:dashboard": "node Tools/testing/run-dashboard-tests.mjs",
    "test:student-home": "node Tools/testing/run-student-home-tests.mjs",
    "test:dashboard:legacy": "node --import ./Tools/testing/register-tsx.mjs --test src/lib/__tests__/assessmentPresentation.test.tsx src/lib/__tests__/dashboardAnalytics.test.tsx src/lib/__tests__/currentGameDashboard.test.ts src/lib/__tests__/evidenceDisplay.test.tsx src/lib/__tests__/questionDisplay.test.tsx",
    "test:dashboard:browser": "node Tools/testing/run-session-tests.mjs --browser",
    "test:sessions": "node Tools/testing/run-session-tests.mjs",
    "seed:accounts": "node --env-file=.env.local supabase/seed/seed-accounts.mjs",
    "test:crypto": "node --conditions=react-server --experimental-strip-types --test src/lib/__tests__/assessmentCrypto.test.ts",
    "test:scoring": "node --conditions=react-server --experimental-strip-types --test src/lib/scoring/__tests__/*.test.ts",
    "test:vr-codes": "node --conditions=react-server --experimental-strip-types --test src/lib/__tests__/vrAccessCodes.test.ts src/lib/__tests__/vrUploadAuthorization.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
